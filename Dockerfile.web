FROM node:24-bookworm-slim AS build
WORKDIR /src
COPY scripts/build-web.js scripts/build-web.js
COPY public/web public/web
COPY public/js/canvas.js public/js/canvas.js
COPY public/assets/libreflow-logo.svg public/assets/libreflow-logo.svg
RUN node scripts/build-web.js
FROM nginx:1.28-alpine
COPY --from=build --chown=101:101 /src/dist/web /usr/share/nginx/html
COPY --chown=101:101 deploy/web-nginx.conf /etc/nginx/conf.d/default.conf
RUN sed -i 's|^[[:space:]]*pid[[:space:]][^;]*;|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf \
    && chown -R 101:101 /var/cache/nginx
USER 101:101
EXPOSE 8080
