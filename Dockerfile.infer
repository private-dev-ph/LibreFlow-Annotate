FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DEFAULT_TIMEOUT=300

RUN apt-get update \
    && apt-get install -y --no-install-recommends libglib2.0-0 libgomp1 libgl1 \
    && rm -rf /var/lib/apt/lists/*

COPY py_scripts/requirements.txt ./py_scripts/requirements.txt

# Install CPU PyTorch first so the default Docker image does not pull the
# much larger CUDA dependency stack. For GPU images, replace this with the
# PyTorch command matching your CUDA runtime.
RUN pip install --index-url https://download.pytorch.org/whl/cpu torch torchvision \
    && pip install -r py_scripts/requirements.txt

COPY py_scripts ./py_scripts

RUN mkdir -p data uploads models datasets

EXPOSE 7878

CMD ["uvicorn", "py_scripts.infer_server:app", "--host", "0.0.0.0", "--port", "7878"]
